<?xml version="1.0" encoding="utf-8"?>

<!--
This makes all files in "/cache/shared" exposed to other apps. They can access these files through a
content URI that is generated by Password Vault. This way, users can decide to open encrypted
documents in other apps as well.
-->
<paths
    xmlns:android="http://schemas.android.com/apk/res/android">

    <cache-path
        name="shared"
        path="shared/"/>
</paths>
