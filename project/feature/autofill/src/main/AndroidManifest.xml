<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Activity for autofill authentication -->
        <activity
            android:name="de.christian2003.feature.autofill.presentation.ui.auth.AutofillAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.PasswordVault.AutofillAuth"
            android:windowSoftInputMode="adjustNothing"/>

        <!-- Autofill service -->
        <service
            android:name="de.christian2003.feature.autofill.infrastructure.android.PasswordVaultAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">

            <intent-filter>
                <action android:name="android.service.autofill.AutofillService"/>
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service"/>
        </service>
    </application>
</manifest>
