<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/md_theme_surface"
    android:paddingHorizontal="@dimen/margin_horizontal"
    android:paddingVertical="@dimen/padding_vertical">

    <ImageView
        android:layout_width="@dimen/image_s"
        android:layout_height="@dimen/image_s"
        android:layout_gravity="center"
        android:src="@drawable/launcher_foreground_fullscale"
        android:tint="@color/md_theme_primary"
        tools:ignore="ContentDescription"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_horizontal"
        android:orientation="vertical"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textColor="@color/md_theme_onSurface"
            tools:text="Email address"/>

        <TextView
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/md_theme_onSurfaceVariant"
            tools:text="john.doe@gmail.com"/>

    </LinearLayout>

</LinearLayout>
